{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "incremental": false,
    "noEmit": true
  },
  "include": ["*-usage-source/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
